@page "/accounting/{CompanyId}/reports/asientos"
@inject IPostingPeriodService PeriodService
@inject IJournalEntryService JournalEntryService
@inject ILocalStorageService LocalStorageService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Reporte de asientos - Aries Contabilidad</PageTitle>

<div class="container-fluid px-0">
    <div class="page-header">
        <h1 class="page-title mb-0">Reporte de asientos</h1>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-secondary" @onclick="GoBack">Volver</button>
            <button type="button" class="btn btn-primary" disabled="@(_rows.Count == 0 || _loading)" @onclick="ExportCsv">Exportar</button>
        </div>
    </div>

    @if (_loadingPeriods)
    {
        <div class="d-flex justify-content-center py-5">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_periods.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Esta compañía no tiene periodos contables.</MudAlert>
    }
    else
    {
        <MudGrid Class="mb-3">
            <MudItem xs="12" md="4" lg="3">
                <MudSelect T="int"
                           Label="Mes inicial"
                           Value="_startId"
                           ValueChanged="OnStartChanged"
                           ToStringFunc="FormatPeriod"
                           Disabled="@(_allMonths || _loading)"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var period in _periods)
                    {
                        <MudSelectItem T="int" Value="@period.Id">@period.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" lg="3">
                <MudSelect T="int"
                           Label="Mes final"
                           Value="_endId"
                           ValueChanged="OnEndChanged"
                           ToStringFunc="FormatPeriod"
                           Disabled="@(_allMonths || _loading)"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var period in EndOptions)
                    {
                        <MudSelectItem T="int" Value="@period.Id">@period.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" lg="3" Class="d-flex align-center">
                <MudCheckBox @bind-Value="_allMonths"
                             @bind-Value:after="OnAllMonthsToggled"
                             Label="Traer todos los meses"
                             Disabled="@_loading" />
            </MudItem>
        </MudGrid>

        @if (_loading)
        {
            <div class="d-flex justify-content-center py-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No hay asientos en el rango seleccionado.</MudAlert>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Mes</th>
                            <th>Número</th>
                            <th>Cuenta</th>
                            <th>Referencia</th>
                            <th>Detalle</th>
                            <th>Fecha doc</th>
                            <th class="text-end">Débitos</th>
                            <th class="text-end">Créditos</th>
                            <th>Moneda</th>
                            @if (ShowFx)
                            {
                                <th class="text-end">Tipo cambio</th>
                                <th class="text-end">Monto USD</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>@row.PostingPeriodName</td>
                                <td>@row.JournalEntryNumber</td>
                                <td>@row.AccountName</td>
                                <td>@row.Reference</td>
                                <td>@row.Memo</td>
                                <td>@row.DocDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@FormatAmount(row.DebitAmount)</td>
                                <td class="text-end">@FormatAmount(row.CreditAmount)</td>
                                <td>@row.Currency</td>
                                @if (ShowFx)
                                {
                                    <td class="text-end">@AsientosUi.Colones(row.RateAmount)</td>
                                    <td class="text-end">@AsientosUi.Dollars(row.ForeignAmount)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string CompanyId { get; set; } = string.Empty;

    private List<PostingPeriod> _periods = new();
    private List<JournalEntryReport> _rows = new();
    private CurrencyTypeCompany _moneyType = CurrencyTypeCompany.Dolares_y_Colones;
    private int _startId;
    private int _endId;
    private bool _allMonths;
    private bool _loadingPeriods = true;
    private bool _loading;
    private string _loadedCompanyId = string.Empty;

    private bool ShowFx => AsientosUi.ShowForeignColumns(_moneyType);
    private IEnumerable<PostingPeriod> EndOptions => AsientosUi.EndOptions(_periods, _startId);

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedCompanyId, CompanyId, StringComparison.OrdinalIgnoreCase))
            return;

        _loadedCompanyId = CompanyId;
        await LoadPeriodsAsync();
    }

    private async Task LoadPeriodsAsync()
    {
        _loadingPeriods = true;
        try
        {
            var company = await LocalStorageService.GetStoredCompany();
            if (company != null)
                _moneyType = company.MoneyType;

            _periods = (await PeriodService.GetPostingPeriodsAsync(CompanyId))
                .OrderBy(p => p.Date)
                .ToList();
            var current = _periods.LastOrDefault();
            _startId = current?.Id ?? 0;
            _endId = current?.Id ?? 0;
            _allMonths = false;
            if (_periods.Count > 0)
                await LoadReportAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingPeriods = false;
        }
    }

    private async Task OnStartChanged(int id)
    {
        _startId = id;
        var start = _periods.FirstOrDefault(p => p.Id == _startId);
        var end = _periods.FirstOrDefault(p => p.Id == _endId);
        if (start != null && (end == null || end.Date < start.Date))
            _endId = EndOptions.LastOrDefault()?.Id ?? _startId;
        await LoadReportAsync();
    }

    private async Task OnEndChanged(int id)
    {
        _endId = id;
        await LoadReportAsync();
    }

    private async Task OnAllMonthsToggled()
    {
        if (_allMonths && _periods.Count > 0)
        {
            _startId = _periods.First().Id;
            _endId = _periods.Last().Id;
        }
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        if (_periods.Count == 0)
            return;

        _loading = true;
        try
        {
            var start = _periods.First(p => p.Id == _startId);
            var end = _periods.First(p => p.Id == _endId);
            _rows = await JournalEntryService.GetJournalEntryReportAsync(new BasicReportParam
            {
                CompanyId = CompanyId,
                FirstDate = AsientosUi.PeriodKey(start),
                EndDate = AsientosUi.PeriodKey(end)
            });
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo cargar el reporte. Compruebe que la API esté actualizada.", Severity.Error);
            _rows = new List<JournalEntryReport>();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _rows = new List<JournalEntryReport>();
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatAmount(decimal amount) =>
        _moneyType == CurrencyTypeCompany.Solo_Dolares
            ? AsientosUi.Dollars(amount)
            : AsientosUi.Colones(amount);

    private async Task ExportCsv()
    {
        var lines = new List<string>
        {
            ShowFx
                ? "Mes Contable,Número,Cuenta,Referencia,Detalle,Fecha de Documento,Debitos,Creditos,Moneda,Tipo Cambio,Monto Dólares"
                : "Mes Contable,Número,Cuenta,Referencia,Detalle,Fecha de Documento,Debitos,Creditos,Moneda"
        };

        foreach (var row in _rows)
        {
            var cols = new List<string>
            {
                AsientosUi.CsvEscape(row.PostingPeriodName),
                row.JournalEntryNumber.ToString(),
                AsientosUi.CsvEscape(row.AccountName),
                AsientosUi.CsvEscape(row.Reference),
                AsientosUi.CsvEscape(row.Memo),
                row.DocDate.ToString("dd/MM/yyyy"),
                row.DebitAmount.ToString("N2"),
                row.CreditAmount.ToString("N2"),
                AsientosUi.CsvEscape(row.Currency)
            };
            if (ShowFx)
            {
                cols.Add(row.RateAmount.ToString("N2"));
                cols.Add(row.ForeignAmount.ToString("N2"));
            }
            lines.Add(string.Join(",", cols));
        }

        await JS.InvokeVoidAsync("ariesAsientos.download", $"REPORTE DE ASIENTOS {CompanyId}.csv", string.Join("\r\n", lines), "text/csv;charset=utf-8;");
    }

    private string FormatPeriod(int id) =>
        _periods.FirstOrDefault(p => p.Id == id)?.ToString() ?? string.Empty;

    private void GoBack() =>
        NavigationManager.NavigateTo($"/accounting/{CompanyId}/reports");
}
