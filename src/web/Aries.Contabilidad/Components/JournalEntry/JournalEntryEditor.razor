@using Microsoft.AspNetCore.Components.Forms


<EditForm Model="@JournalEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudGrid>
            <MudItem xs="12" sm="10">
                <MudText Typo="Typo.h4" Class="mb-4">@Title</MudText>
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex justify-end">
                <MudButton Color="Color.Primary" 
                          OnClick="CreateNewJournalEntry" 
                          StartIcon="@Icons.Material.Filled.Add"
                          Variant="Variant.Filled">
                    New Entry
                </MudButton>
            </MudItem>
        </MudGrid>

        <JournalEntryHeader 
        JournalEntry="JournalEntry"
        PostingPeriodId="JournalEntry?.PostingPeriodId ?? 0"
        JournalEntryIdChanged="HandleJournalEntryIdChanged"
        PostingPeriodIdChanged="HandlePostingPeriodChanged"
        PostingPeriods="@_postingPeriods"
        JournalEntries="@_journalEntries" />

        <JournalEntryLinesEditor 
        Lines="@(JournalEntry?.JournalEntryLines ?? new List<JournalEntryLine>())"
        OnLineChanged="HandleLineChanged"
        OnLineDeleted="HandleLineDeleted" 
        CompanyId="@CompanyId"/>

        <JournalEntrySummary 
        TotalDebit="@_totalDebit"
        TotalCredit="@_totalCredit"
        IsBalanced="@IsBalanced" />

    </MudContainer>
</EditForm>

@code {
    [Parameter]
    public string CompanyId { get; set; } 

    /// <summary>
    /// Title of the editor form
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Create Journal Entry";

    /// <summary>
    /// Callback invoked when the journal entry is saved
    /// </summary>
    [Parameter]
    public EventCallback<JournalEntry> OnSave { get; set; }

    /// <summary>
    /// Callback invoked when editing is cancelled
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// The journal entry model being edited
    /// </summary>
    [Parameter]
    public JournalEntry JournalEntry { get; set; } = new JournalEntry
    {
        JournalEntryLines = new List<JournalEntryLine>(),
        JournalEntryStatus = JournalEntryStatus.Progress,
        CreatedAt = DateTime.Now,
        UpdateAt = DateTime.Now
    };

    private List<PostingPeriod> _postingPeriods = new();
    private List<JournalEntry> _journalEntries = new();
    private decimal _totalDebit;
    private decimal _totalCredit;

    [Inject]
    private IPostingPeriodService PostingPeriodService { get; set; } = default!;

    [Inject]
    private IJournalEntryService JournalEntryService { get; set; } = default!;

    [Inject]
    private IJournalEntryLineService JournalEntryLineService { get; set; } = default!;

    [Inject]
    private ILocalStorageService LocalStorageService { get; set; } = default!;

    /// <summary>
    /// Indicates whether debits and credits are balanced
    /// </summary>
    public bool IsBalanced => Math.Abs(_totalDebit - _totalCredit) < 0.01m;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _postingPeriods = await PostingPeriodService.GetPostingPeriodsAsync(CompanyId);
            var lastPostingPeriod = _postingPeriods.OrderByDescending(p => p.Date).FirstOrDefault();
            if (lastPostingPeriod != null)
            {
                await HandlePostingPeriodChanged(lastPostingPeriod.Id);
            }
            CalculateTotals();
        }
        catch (Exception ex)
        {
            // Handle error appropriately
        }
    }

    private async Task CreateNewJournalEntry()
    {
        var lastPostingPeriod = _postingPeriods.OrderByDescending(p => p.Date).FirstOrDefault();
        if (lastPostingPeriod != null)
        {
            await HandlePostingPeriodChanged(lastPostingPeriod.Id);
        }
    }

    private async Task<List<JournalEntry>> GetConsecutiveNumberAsync(int postingPeriodId)
    {
        var allJournalEntries = await JournalEntryService.GetJournalEntriesAsync(postingPeriodId);
        var newJournalEntryId = await JournalEntryService.GetConsecutiveNumberAsync(postingPeriodId);

        var newEntry = new JournalEntry
        {
            Id = 0,
            CreatedAt = DateTime.Now,
            UpdateAt = DateTime.Now,
            JournalEntryStatus = JournalEntryStatus.Progress,
            PostingPeriodId = postingPeriodId,
            Number = newJournalEntryId,
            JournalEntryLines = new List<JournalEntryLine>()
        };

        JournalEntry = newEntry;
        allJournalEntries.Add(newEntry);
        return allJournalEntries;
    }

    private void CalculateTotals()
    {
        if (JournalEntry?.JournalEntryLines == null) return;

        _totalDebit = JournalEntry.JournalEntryLines
            .Where(l => l.DebOrCred == DebOrCred.Debito)
            .Sum(l => l.Amount);

        _totalCredit = JournalEntry.JournalEntryLines
            .Where(l => l.DebOrCred == DebOrCred.Credito)
            .Sum(l => l.Amount);
    }

    private async Task HandlePostingPeriodChanged(int periodId)
    {
        _journalEntries = await GetConsecutiveNumberAsync(periodId);
        StateHasChanged(); 
    }

    private async Task HandleJournalEntryIdChanged(JournalEntry journalEntry)
    {
        if (JournalEntry != null && !ReferenceEquals(JournalEntry, journalEntry) && !JournalEntry.CanNavigateAway())
            return;

        JournalEntry = journalEntry;

        if (journalEntry.Id == 0)
        {
            var user = await LocalStorageService.GetCurrentUserSesion();
            JournalEntry.CreatedBy = user.Id;
            JournalEntry.UpdatedBy = user.Id;
        }
        else
        {
            var existingLines = await JournalEntryLineService.GetJournalEntryLinesAsync(journalEntry.Id);
            journalEntry.JournalEntryLines = existingLines ?? new List<JournalEntryLine>();
        }
        CalculateTotals();
        StateHasChanged();
    }

    private async void HandleLineChanged(JournalEntryLine line)
    {
        var user = await LocalStorageService.GetCurrentUserSesion();

        // If this is a new journal entry, create it first
        if (JournalEntry.Id == 0)
        {
            JournalEntry.CreatedBy = user.Id;
            JournalEntry.UpdatedBy = user.Id;
            JournalEntry.Id = await JournalEntryService.CreateJournalEntryAsync(JournalEntry);
        }

        // Set the line's properties
        line.JournalEntryId = JournalEntry.Id;
        line.CreatedBy = user.Id; 
        line.UpdatedBy = user.Id;

        // Handle new vs existing line
        if (line.Id == 0)
        {
            await JournalEntryLineService.CreateJournalEntryLineAsync(line);
            JournalEntry.JournalEntryLines.Add(line);
        }
        else
        {
            await JournalEntryLineService.UpdateJournalEntryLineAsync(line);
        }

        // Update the journal entry
        await JournalEntryService.UpdateJournalEntryAsync(JournalEntry);

        CalculateTotals();
        StateHasChanged();
    }

    private async void HandleLineDeleted(JournalEntryLine line)
    {
        await JournalEntryLineService.DeleteJournalEntryLineAsync(line);
        JournalEntry.JournalEntryLines.Remove(line);
        CalculateTotals();
        StateHasChanged();
    }

    // private async Task HandleValidSubmit()
    // {
    //     if (IsBalanced)
    //     {
    //         await OnSave.InvokeAsync(JournalEntry);
    //     }
    // }
}
