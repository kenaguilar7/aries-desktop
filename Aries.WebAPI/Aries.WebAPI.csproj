<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aries.WebAPI</RootNamespace>
    <UserSecretsId>aries-webapi-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="MySqlConnector" Version="0.56.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('appsettings.Local.json')" />
    <None Include="appsettings.Local.json.example" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AriesContador.Core\AriesContador.Core.csproj" />
    <ProjectReference Include="..\AriesContador.Data\AriesContador.Data.csproj" />
    <ProjectReference Include="..\AriesContador.Services\AriesContador.Services.csproj" />
  </ItemGroup>

</Project>
