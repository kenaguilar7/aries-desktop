@page "/integration/{CompanyId}/purchase-accounting"
@using AriesContador.Core.Models.JournalEntries
@using AriesContador.Core.Models.Purchases
@inject IPurchaseAccountingClient AccountingClient

<PageTitle>Compras → Contabilidad - Aries Contabilidad</PageTitle>

<div class="container-fluid">
    <h1 class="page-title">Compras → Contabilidad</h1>
    <p class="text-muted">Genere un asiento por cada factura de compra confirmada (inventario, IVA soportado y CxP o medio de pago).</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="alert alert-success">@infoMessage</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5>Compras pendientes de asentar</h5>
            @if (purchases == null)
            {
                <div class="d-flex justify-content-center"><div class="spinner-border"></div></div>
            }
            else if (purchases.Count == 0)
            {
                <p class="text-muted mb-0">No hay compras confirmadas sin asentar.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                                <th>Factura</th>
                                <th>Pago</th>
                                <th class="text-end">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var purchase in purchases)
                            {
                                <tr>
                                    <td>@purchase.PurchasedAt.ToString("g")</td>
                                    <td>@(purchase.SupplierName ?? ("#" + purchase.SupplierId))</td>
                                    <td>@purchase.DocumentNumber</td>
                                    <td>@PurchaseSettlementNames.ToDisplay(purchase.PaymentMethod)</td>
                                    <td class="text-end">@purchase.Total.ToString("N2")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-primary" @onclick="() => Preview(purchase.Id)" disabled="@busy">Vista previa</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (preview != null)
    {
        <div class="card">
            <div class="card-body">
                <h5>Vista previa del asiento</h5>
                <p class="text-muted mb-2">
                    Periodo: @(preview.PeriodName ?? "—")
                    @if (preview.AlreadyPosted && preview.JournalEntryId.HasValue)
                    {
                        <span> — asiento #@preview.JournalEntryId</span>
                    }
                </p>
                <div class="row mb-3">
                    <div class="col-md-3"><strong>Neto</strong><div>@preview.NetAmount.ToString("N2")</div></div>
                    <div class="col-md-3"><strong>IVA soportado</strong><div>@preview.TaxAmount.ToString("N2")</div></div>
                    <div class="col-md-3"><strong>Total</strong><div>@preview.Total.ToString("N2")</div></div>
                    <div class="col-md-3"><strong>Pago</strong><div>@PurchaseSettlementNames.ToDisplay(preview.PaymentMethod)</div></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Cuenta</th>
                                <th>Detalle</th>
                                <th class="text-end">Débito</th>
                                <th class="text-end">Crédito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in preview.Lines)
                            {
                                <tr>
                                    <td>
                                        <div>@(string.IsNullOrWhiteSpace(line.AccountName) ? line.AccountId.ToString() : line.AccountName)</div>
                                        @if (!string.IsNullOrWhiteSpace(line.AccountPath))
                                        {
                                            <div class="text-muted small text-truncate" title="@line.AccountPath">@line.AccountPath</div>
                                        }
                                    </td>
                                    <td>@line.Memo</td>
                                    <td class="text-end">@(line.DebOrCred == DebOrCred.Debito ? line.Amount.ToString("N2") : "")</td>
                                    <td class="text-end">@(line.DebOrCred == DebOrCred.Credito ? line.Amount.ToString("N2") : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!preview.AlreadyPosted)
                {
                    <button class="btn btn-success" @onclick="ConfirmPost" disabled="@busy">Generar asiento</button>
                }
                else if (preview.JournalEntryId.HasValue)
                {
                    <a class="btn btn-outline-primary" href="@($"/journal-entries/{CompanyId}")">Ver asientos</a>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string CompanyId { get; set; } = string.Empty;
    private List<Purchase>? purchases;
    private PurchasePostingPreview? preview;
    private int previewPurchaseId;
    private bool busy;
    private string? errorMessage;
    private string? infoMessage;
    private string? _loadedCompany;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedCompany == CompanyId && purchases != null)
            return;
        _loadedCompany = CompanyId;
        await Reload();
    }

    private async Task Reload()
    {
        errorMessage = null;
        purchases = await AccountingClient.GetUnpostedPurchasesAsync(CompanyId);
    }

    private async Task Preview(int purchaseId)
    {
        busy = true;
        errorMessage = null;
        infoMessage = null;
        try
        {
            previewPurchaseId = purchaseId;
            preview = await AccountingClient.PreviewPurchaseAsync(purchaseId);
        }
        catch (Exception ex)
        {
            preview = null;
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmPost()
    {
        busy = true;
        errorMessage = null;
        infoMessage = null;
        try
        {
            preview = await AccountingClient.PostPurchaseAsync(previewPurchaseId);
            infoMessage = preview.JournalEntryId.HasValue
                ? $"Asiento #{preview.JournalEntryId} generado"
                : "Asiento generado";
            await Reload();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
