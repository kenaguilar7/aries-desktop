@page "/accounts/{CompanyId}/nueva/{ParentId:int}"
@using AriesContador.Core.Models.Accounts
@inject IAccountService AccountService
@inject NavigationManager NavigationManager

<PageTitle>Nueva cuenta - Aries Contabilidad</PageTitle>

<div class="container-fluid px-0">
    <div class="page-header">
        <h1 class="page-title mb-0">Nueva cuenta</h1>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="GoBack">Volver</button>
            <button type="button" class="btn btn-primary" disabled="@(_busy || !CanSave)" @onclick="SaveAsync">Guardar</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <div class="card account-create-form">
            <div class="card-body">
                @if (_parent == null)
                {
                    <p class="text-muted mb-0">No se encontró la cuenta padre.</p>
                }
                else if (_parent.AccountType == AccountType.Cuenta_Titulo)
                {
                    <p class="text-muted mb-0">No se puede crear cuentas bajo un título. Vuelva al plan de cuentas y elija una mayor o auxiliar.</p>
                }
                else
                {
                    <dl class="account-create-meta mb-4">
                        <div>
                            <dt>Cuenta padre</dt>
                            <dd>@_parent.Name</dd>
                        </div>
                        <div>
                            <dt>Tipo de cuenta</dt>
                            <dd>@AccountUi.TagLabel(_parent.AccountTag)</dd>
                        </div>
                        <div>
                            <dt>Indicador</dt>
                            <dd>La nueva cuenta se crea como auxiliar.</dd>
                        </div>
                    </dl>

                    @if (!string.IsNullOrEmpty(_warning))
                    {
                        <p class="account-create-warning">@_warning</p>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="new-account-name">Nombre</label>
                        <input id="new-account-name"
                               class="form-control"
                               maxlength="45"
                               disabled="@_busy"
                               @bind="_name"
                               @bind:event="oninput"
                               @bind:after="NormalizeName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="new-account-memo">Detalle</label>
                        <input id="new-account-memo"
                               class="form-control"
                               maxlength="45"
                               disabled="@_busy"
                               @bind="_memo"
                               @bind:event="oninput"
                               @bind:after="NormalizeMemo" />
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p class="text-danger mb-0">@_error</p>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string CompanyId { get; set; } = string.Empty;

    [Parameter]
    public int ParentId { get; set; }

    private Account? _parent;
    private string _name = string.Empty;
    private string _memo = string.Empty;
    private string? _error;
    private string? _warning;
    private bool _loading = true;
    private bool _busy;
    private string _loadedKey = string.Empty;

    private bool CanSave =>
        _parent != null && _parent.AccountType != AccountType.Cuenta_Titulo;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{CompanyId}:{ParentId}";
        if (string.Equals(_loadedKey, key, StringComparison.OrdinalIgnoreCase))
            return;

        _loadedKey = key;
        await LoadParentAsync();
    }

    private async Task LoadParentAsync()
    {
        _loading = true;
        _error = null;
        _warning = null;
        try
        {
            _parent = await AccountService.FindAccountAsync(ParentId);
            if (_parent != null && _parent.AccountType != AccountType.Cuenta_Titulo)
            {
                var evaluation = await AccountService.EvaluateParentAsync(_parent);
                if (evaluation != null && !evaluation.CanProceed)
                    _warning = FormatWarning(evaluation.Message);
            }
        }
        catch (Exception ex)
        {
            _parent = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatWarning(string? message)
    {
        var text = (message ?? string.Empty)
            .Replace("¿Desea continuar y crear una cuenta nueva?", string.Empty)
            .Trim();
        if (string.IsNullOrEmpty(text))
            return text;

        return text + "\nSi guarda, esos saldos pasan a la cuenta nueva.";
    }

    private void NormalizeName() => _name = (_name ?? string.Empty).ToUpperInvariant();

    private void NormalizeMemo() => _memo = (_memo ?? string.Empty).ToUpperInvariant();

    private async Task SaveAsync()
    {
        _error = null;
        if (_parent == null || !CanSave)
            return;

        if (!AccountRules.ValidateName(_name, out var message))
        {
            _error = message;
            return;
        }

        _busy = true;
        try
        {
            await AccountService.CreateAccountAsync(new Account
            {
                Name = _name.Trim(),
                Memo = _memo.Trim(),
                FatherAccount = _parent.Id,
                CompanyId = string.IsNullOrEmpty(CompanyId) ? _parent.CompanyId : CompanyId,
                AccountType = AccountType.Cuenta_Auxiliar,
                AccountTag = _parent.AccountTag,
                Editable = true
            });

            NavigationManager.NavigateTo($"/accounts/{CompanyId}?cuenta={_parent.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack() =>
        NavigationManager.NavigateTo($"/accounts/{CompanyId}?cuenta={ParentId}");
}
