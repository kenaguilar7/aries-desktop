@implements IDisposable
@inject IPostingPeriodService PostingPeriodService
@inject IJournalEntryService JournalEntryService
@inject IJournalEntryLineService JournalEntryLineService
@inject ILocalStorageService LocalStorageService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject JournalWorkspaceGuard WorkspaceGuard

<div class="asientos-workspace" @ref="_workspace">
    <div class="page-header">
        <h1 class="page-title mb-0">Asientos</h1>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" disabled="@(_busy || PeriodClosed || _postingPeriods.Count == 0)" @onclick="CreateNewJournalEntry">
                Nuevo asiento
            </button>
            <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="RefreshGrid">Refrescar</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (_postingPeriods.Count == 0)
    {
        <div class="alert alert-info">Esta compañía no tiene periodos contables. Ábralos en Periodos antes de registrar asientos.</div>
    }
    else
    {
        <JournalEntryHeader PostingPeriodId="JournalEntry.PostingPeriodId"
                            SelectedEntryId="JournalEntry.Id"
                            PostingPeriods="_postingPeriods"
                            JournalEntries="_journalEntries"
                            IsBalanced="IsBalanced"
                            PeriodClosed="PeriodClosed"
                            PostingPeriodIdChanged="HandlePostingPeriodChanged"
                            JournalEntryIdChanged="HandleJournalEntryIdChanged" />

        <div class="mt-3">
            <JournalEntryLineComposer @ref="_composer"
                                      CompanyId="@CompanyId"
                                      ReadOnly="PeriodClosed"
                                      CurrencyLocked="AsientosUi.CurrencyLocked(_moneyType)"
                                      DefaultCurrency="AsientosUi.DefaultCurrency(_moneyType)"
                                      OnSubmit="HandleLineSubmit"
                                      OnCancel="HandleComposerCancel" />
        </div>

        <div class="mt-3">
            <JournalEntryLinesEditor Lines="@(JournalEntry.JournalEntryLines ?? new List<JournalEntryLine>())"
                                     SelectedIds="_selectedIds"
                                     SelectedIdsChanged="OnSelectionChanged"
                                     ShowFx="AsientosUi.ShowForeignColumns(_moneyType)"
                                     ReadOnly="PeriodClosed" />
        </div>

        <JournalEntrySummary TotalDebit="_totalDebit"
                             TotalCredit="_totalCredit"
                             IsBalanced="IsBalanced"
                             CanTransfer="CanTransfer"
                             CanEditLine="CanEditLine"
                             CanDeleteLines="CanDeleteLines"
                             CanDeleteEntry="CanDeleteEntry"
                             CanClear="CanClear"
                             OnTransfer="TransferPeriod"
                             OnEditLine="EditSelectedLine"
                             OnDeleteLines="DeleteSelectedLines"
                             OnDeleteEntry="DeleteJournalEntry"
                             OnClear="ClearWorkspace" />
    }
</div>

@code {
    [Parameter] public string CompanyId { get; set; } = string.Empty;

    public JournalEntry JournalEntry { get; set; } = new()
    {
        JournalEntryLines = new List<JournalEntryLine>(),
        JournalEntryStatus = JournalEntryStatus.Progress
    };

    private JournalEntryLineComposer? _composer;
    private List<PostingPeriod> _postingPeriods = new();
    private List<JournalEntry> _journalEntries = new();
    private HashSet<int> _selectedIds = new();
    private CurrencyTypeCompany _moneyType = CurrencyTypeCompany.Dolares_y_Colones;
    private decimal _totalDebit;
    private decimal _totalCredit;
    private bool _loading = true;
    private bool _busy;
    private ElementReference _workspace;
    private DotNetObjectReference<JournalEntryEditor>? _dotNetRef;
    private bool _shortcutsBound;
    private string _loadedCompanyId = string.Empty;

    public bool IsBalanced => JournalEntry.Cuadrado;
    private bool PeriodClosed => CurrentPeriod?.Closed == true;
    private PostingPeriod? CurrentPeriod => _postingPeriods.FirstOrDefault(p => p.Id == JournalEntry.PostingPeriodId);
    private bool CanTransfer => !_busy && !PeriodClosed && JournalEntry.Id != 0 && IsBalanced && (JournalEntry.JournalEntryLines?.Count ?? 0) > 0;
    private bool CanEditLine => !_busy && !PeriodClosed && _selectedIds.Count == 1;
    private bool CanDeleteLines => !_busy && !PeriodClosed && _selectedIds.Count > 0;
    private bool CanDeleteEntry => !_busy && !PeriodClosed && JournalEntry.Id != 0;
    private bool CanClear => !_busy && !PeriodClosed && JournalEntry.CanNavigateAway();

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedCompanyId, CompanyId, StringComparison.OrdinalIgnoreCase))
            return;

        _loadedCompanyId = CompanyId;
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        try
        {
            var company = await LocalStorageService.GetStoredCompany();
            if (company != null)
                _moneyType = company.MoneyType;

            _postingPeriods = (await PostingPeriodService.GetPostingPeriodsAsync(CompanyId))
                .OrderByDescending(p => p.Date)
                .ToList();

            _journalEntries = new List<JournalEntry>();
            _selectedIds = new HashSet<int>();
            _composer?.Clear();

            var last = _postingPeriods.FirstOrDefault();
            if (last != null)
                await LoadPeriodAsync(last.Id, selectDraft: true);
            else
            {
                JournalEntry = new JournalEntry
                {
                    JournalEntryLines = new List<JournalEntryLine>(),
                    JournalEntryStatus = JournalEntryStatus.Progress
                };
                CalculateTotals();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            SyncGuard();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shortcutsBound || _loading)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("ariesAsientos.bindShortcuts", _workspace, _dotNetRef);
        _shortcutsBound = true;
    }

    [JSInvokable]
    public async Task OnShortcut(string name)
    {
        if (_composer == null || PeriodClosed)
            return;

        switch (name)
        {
            case "account":
                await _composer.OpenAccountPickerFromShortcut();
                break;
            case "debit":
                _composer.SetDebit();
                break;
            case "credit":
                _composer.SetCredit();
                break;
            case "submit":
                await _composer.SubmitFromShortcut();
                break;
        }
    }

    [JSInvokable]
    public async Task OnEnterAsTab()
    {
        if (_composer == null)
            return;
        await JS.InvokeVoidAsync("ariesAsientos.focusNext", _composer.Element);
    }

    private async Task HandlePostingPeriodChanged(int periodId)
    {
        if (!EnsureCanLeave())
            return;
        await LoadPeriodAsync(periodId, selectDraft: true);
    }

    private async Task HandleJournalEntryIdChanged(int entryId)
    {
        var next = _journalEntries.FirstOrDefault(e => e.Id == entryId);
        if (next == null)
            return;
        if (!ReferenceEquals(JournalEntry, next) && !EnsureCanLeave())
            return;
        await SelectEntryAsync(next);
    }

    private async Task CreateNewJournalEntry()
    {
        if (!EnsureCanLeave())
            return;

        _busy = true;
        try
        {
            if (JournalEntry.Id == 0)
            {
                var user = await LocalStorageService.GetCurrentUserSesion();
                JournalEntry.CreatedBy = user.Id;
                JournalEntry.UpdatedBy = user.Id;
                JournalEntry.Id = await JournalEntryService.CreateJournalEntryAsync(JournalEntry);
            }

            await LoadPeriodAsync(JournalEntry.PostingPeriodId, selectDraft: true);
            _composer?.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadPeriodAsync(int postingPeriodId, bool selectDraft, int? selectId = null)
    {
        var all = await JournalEntryService.GetJournalEntriesAsync(postingPeriodId);
        var nextNumber = await JournalEntryService.GetConsecutiveNumberAsync(postingPeriodId);
        var draft = new JournalEntry
        {
            Id = 0,
            CreatedAt = DateTime.Now,
            UpdateAt = DateTime.Now,
            JournalEntryStatus = JournalEntryStatus.Progress,
            PostingPeriodId = postingPeriodId,
            Number = nextNumber,
            JournalEntryLines = new List<JournalEntryLine>()
        };
        all.Add(draft);
        _journalEntries = all.OrderByDescending(e => e.Number).ThenBy(e => e.Id).ToList();

        JournalEntry selected;
        if (selectId.HasValue)
            selected = _journalEntries.FirstOrDefault(e => e.Id == selectId.Value) ?? draft;
        else if (selectDraft)
            selected = draft;
        else
            selected = _journalEntries.FirstOrDefault(e => e.Id == JournalEntry.Id) ?? draft;

        await SelectEntryAsync(selected);
    }

    private async Task SelectEntryAsync(JournalEntry entry)
    {
        JournalEntry = entry;
        _selectedIds = new HashSet<int>();
        if (entry.Id == 0)
        {
            entry.JournalEntryLines ??= new List<JournalEntryLine>();
        }
        else
        {
            entry.JournalEntryLines = await JournalEntryLineService.GetJournalEntryLinesAsync(entry.Id)
                                       ?? new List<JournalEntryLine>();
        }

        CalculateTotals();
        SyncGuard();
        StateHasChanged();
    }

    private async Task HandleLineSubmit(JournalEntryLine line)
    {
        _busy = true;
        try
        {
            var user = await LocalStorageService.GetCurrentUserSesion();
            if (JournalEntry.Id == 0)
            {
                JournalEntry.CreatedBy = user.Id;
                JournalEntry.UpdatedBy = user.Id;
                JournalEntry.Id = await JournalEntryService.CreateJournalEntryAsync(JournalEntry);
                var inList = _journalEntries.FirstOrDefault(e => e.Id == 0);
                if (inList != null)
                    inList.Id = JournalEntry.Id;
            }

            line.JournalEntryId = JournalEntry.Id;
            line.CreatedBy = user.Id;
            line.UpdatedBy = user.Id;

            if (line.Id == 0)
            {
                line.Id = await JournalEntryLineService.CreateJournalEntryLineAsync(line);
                JournalEntry.JournalEntryLines.Add(line);
            }
            else
            {
                await JournalEntryLineService.UpdateJournalEntryLineAsync(line);
                var index = JournalEntry.JournalEntryLines.FindIndex(l => l.Id == line.Id);
                if (index >= 0)
                    JournalEntry.JournalEntryLines[index] = line;
            }

            await JournalEntryService.UpdateJournalEntryAsync(JournalEntry);
            _selectedIds.Clear();
            _composer?.Clear(keepAccount: true);
            CalculateTotals();
            SyncGuard();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void HandleComposerCancel()
    {
        _selectedIds.Clear();
    }

    private void OnSelectionChanged(HashSet<int> ids)
    {
        _selectedIds = ids;
    }

    private void EditSelectedLine()
    {
        if (_selectedIds.Count != 1)
            return;
        var id = _selectedIds.First();
        var line = JournalEntry.JournalEntryLines.FirstOrDefault(l => l.Id == id);
        if (line == null)
            return;
        _composer?.LoadLine(line);
    }

    private async Task DeleteSelectedLines()
    {
        var toDelete = JournalEntry.JournalEntryLines.Where(l => _selectedIds.Contains(l.Id)).ToList();
        if (toDelete.Count == 0)
            return;

        var confirmed = await DialogService.ShowMessageBox(
            "Aries Contabilidad",
            $"Se van a eliminar {toDelete.Count} elementos ¿Desea continuar?",
            yesText: "Sí",
            cancelText: "No");
        if (confirmed != true)
            return;

        _busy = true;
        try
        {
            foreach (var line in toDelete)
            {
                await JournalEntryLineService.DeleteJournalEntryLineAsync(line);
                JournalEntry.JournalEntryLines.Remove(line);
            }

            await JournalEntryService.UpdateJournalEntryAsync(JournalEntry);
            _selectedIds.Clear();
            _composer?.Clear();
            CalculateTotals();
            SyncGuard();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteJournalEntry()
    {
        if (JournalEntry.Id == 0)
        {
            Snackbar.Add("No se puede eliminar este asiento porque aun no ha sido registrado", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "Aries Contabilidad",
            "Se eliminara este asiento desea continuar",
            yesText: "Sí",
            cancelText: "No");
        if (confirmed != true)
            return;

        _busy = true;
        try
        {
            await JournalEntryService.DeleteJournalEntryAsync(JournalEntry);
            Snackbar.Add("Asiento eliminado correctamente", Severity.Success);
            await LoadPeriodAsync(JournalEntry.PostingPeriodId, selectDraft: true);
            _composer?.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearWorkspace()
    {
        if (!EnsureCanLeave())
            return;
        var draft = _journalEntries.FirstOrDefault(e => e.Id == 0);
        if (draft != null)
            await SelectEntryAsync(draft);
        _composer?.Clear();
    }

    private async Task TransferPeriod()
    {
        if (!CanTransfer)
            return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<TransferPeriodDialog>
        {
            { x => x.JournalEntry, JournalEntry },
            { x => x.CurrentPeriod, CurrentPeriod },
            { x => x.PostingPeriods, _postingPeriods }
        };
        var dialog = await DialogService.ShowAsync<TransferPeriodDialog>("Cambiar periodo contable de asiento", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: PostingPeriod target })
            return;

        _busy = true;
        try
        {
            JournalEntry.PostingPeriodId = target.Id;
            await JournalEntryService.UpdatePeriodAsync(JournalEntry);
            Snackbar.Add($"Asiento transferido a {target}.", Severity.Success);
            await LoadPeriodAsync(target.Id, selectDraft: false, selectId: JournalEntry.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshGrid()
    {
        if (JournalEntry.PostingPeriodId == 0)
            return;
        await LoadPeriodAsync(JournalEntry.PostingPeriodId, selectDraft: false, selectId: JournalEntry.Id);
    }

    private void CalculateTotals()
    {
        JournalEntry.JournalEntryLines ??= new List<JournalEntryLine>();
        _totalDebit = JournalEntry.DebitosColones;
        _totalCredit = JournalEntry.CreditosColones;
    }

    private bool EnsureCanLeave()
    {
        if (JournalEntry.CanNavigateAway())
            return true;
        Snackbar.Add(JournalWorkspaceGuard.UnbalancedMessage, Severity.Warning);
        return false;
    }

    private void SyncGuard() => WorkspaceGuard.SetCanLeave(JournalEntry.CanNavigateAway());

    public void Dispose()
    {
        WorkspaceGuard.Clear();
        _dotNetRef?.Dispose();
    }
}
