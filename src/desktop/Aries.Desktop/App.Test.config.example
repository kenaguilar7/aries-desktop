<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay para s3://ariescontador/updates-test/.
     Pack-Squirrel fusiona solo connectionStrings; los bindingRedirect salen del build Release.
     No pongas el password de RDS aqui si vas a commitear una copia.
     CI genera un overlay temporal con solo UpdateServerString. -->
<configuration>
  <connectionStrings>
    <add name="UpdateServerString" connectionString="https://s3.us-east-2.amazonaws.com/ariescontador/updates-test/" />
    <add name="IsBeta" connectionString="true" />
  </connectionStrings>
</configuration>
