  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\application\AriesContador.Services\AriesContador.Services.csproj" />
    <ProjectReference Include="..\..\src\domain\AriesContador.Core\AriesContador.Core.csproj" />
    <ProjectReference Include="..\..\src\infrastructure\AriesContador.Data\AriesContador.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schema\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Reportes\Fixtures\*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
