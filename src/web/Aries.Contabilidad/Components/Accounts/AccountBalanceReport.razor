@using AriesContador.Core.Models.Accounts
@using AriesContador.Core.Models.PostingPeriods
@inject IPostingPeriodService PostingPeriodService
@inject IAccountService AccountService
@inject ISnackbar Snackbar

<div class="card">
    <div class="card-body">
        <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Elevation="0">
            <MudTabPanel Text="Saldo Actual">
                <MudGrid Class="mb-3">
                    <MudItem xs="12" md="4" lg="3">
                        <MudTextField Value="@FormatPeriod(_actualFromId)"
                                      Label="Desde"
                                      ReadOnly="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4" lg="3">
                        <MudSelect T="int"
                                   Label="Hasta"
                                   Value="_actualToId"
                                   ValueChanged="OnActualToChanged"
                                   ToStringFunc="FormatPeriod"
                                   Disabled="@(_periods.Count == 0)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var period in _periods)
                            {
                                <MudSelectItem T="int" Value="@period.Id">@period.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                @if (_busyActual)
                {
                    <div class="d-flex justify-content-center py-3">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else if (_actual == null)
                {
                    <p class="text-muted mb-0">Seleccione el periodo final para ver el saldo.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Saldo anterior</th>
                                    <th class="text-end">Débitos</th>
                                    <th class="text-end">Créditos</th>
                                    <th class="text-end">Saldo actual</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@AccountUi.Colones(_actual.PriorBalance)</td>
                                    <td class="text-end">@AccountUi.Colones(_actual.DebitBalance)</td>
                                    <td class="text-end">@AccountUi.Colones(_actual.CreditBalance)</td>
                                    <td class="text-end @BalanceClass(_actual.CurrentBalance)">@AccountUi.Colones(_actual.CurrentBalance)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </MudTabPanel>
            <MudTabPanel Text="Saldos Mensual">
                <MudGrid Class="mb-3">
                    <MudItem xs="12" md="4" lg="3">
                        <MudSelect T="int"
                                   Label="Desde"
                                   Value="_monthlyFromId"
                                   ValueChanged="OnMonthlyFromChanged"
                                   ToStringFunc="FormatPeriod"
                                   Disabled="@(_periods.Count == 0)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var period in _periods)
                            {
                                <MudSelectItem T="int" Value="@period.Id">@period.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4" lg="3">
                        <MudSelect T="int"
                                   Label="Hasta"
                                   Value="_monthlyToId"
                                   ValueChanged="OnMonthlyToChanged"
                                   ToStringFunc="FormatPeriod"
                                   Disabled="@(_periods.Count == 0)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var period in MonthlyEndOptions)
                            {
                                <MudSelectItem T="int" Value="@period.Id">@period.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                @if (_busyMonthly)
                {
                    <div class="d-flex justify-content-center py-3">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else if (_monthly == null)
                {
                    <p class="text-muted mb-0">Seleccione el rango de periodos para ver el saldo mensual.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th class="text-end">Débitos</th>
                                    <th class="text-end">Créditos</th>
                                    <th class="text-end">Saldo mensual</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-end">@AccountUi.Colones(_monthly.DebitBalance)</td>
                                    <td class="text-end">@AccountUi.Colones(_monthly.CreditBalance)</td>
                                    <td class="text-end @BalanceClass(_monthly.MontlyBalance)">@AccountUi.Colones(_monthly.MontlyBalance)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </MudTabPanel>
        </MudTabs>
    </div>
</div>

@code {
    [Parameter]
    public Account? Account { get; set; }

    [Parameter]
    public string CompanyId { get; set; } = string.Empty;

    private List<PostingPeriod> _periods = new();
    private Account? _actual;
    private Account? _monthly;
    private int _actualFromId;
    private int _actualToId;
    private int _monthlyFromId;
    private int _monthlyToId;
    private int _loadedAccountId;
    private string _loadedCompanyId = string.Empty;
    private bool _busyActual;
    private bool _busyMonthly;

    private IEnumerable<PostingPeriod> MonthlyEndOptions =>
        AsientosUi.EndOptions(_periods, _monthlyFromId);

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(CompanyId) || Account == null)
            return;

        if (!string.Equals(_loadedCompanyId, CompanyId, StringComparison.OrdinalIgnoreCase))
        {
            _loadedCompanyId = CompanyId;
            await LoadPeriodsAsync();
        }

        if (_loadedAccountId != Account.Id)
        {
            _loadedAccountId = Account.Id;
            _actual = null;
            _monthly = null;
            await LoadActualAsync();
            await LoadMonthlyAsync();
        }
    }

    private async Task LoadPeriodsAsync()
    {
        try
        {
            _periods = (await PostingPeriodService.GetPostingPeriodsAsync(CompanyId))
                .OrderBy(p => p.Date)
                .ToList();
            _actualFromId = _periods.FirstOrDefault()?.Id ?? 0;
            _actualToId = _periods.LastOrDefault()?.Id ?? 0;
            _monthlyFromId = _actualToId;
            _monthlyToId = _actualToId;
        }
        catch (Exception ex)
        {
            _periods = new List<PostingPeriod>();
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnActualToChanged(int id)
    {
        _actualToId = id;
        await LoadActualAsync();
    }

    private async Task OnMonthlyFromChanged(int id)
    {
        _monthlyFromId = id;
        var start = _periods.FirstOrDefault(p => p.Id == _monthlyFromId);
        var end = _periods.FirstOrDefault(p => p.Id == _monthlyToId);
        if (start != null && (end == null || end.Date < start.Date))
            _monthlyToId = MonthlyEndOptions.LastOrDefault()?.Id ?? _monthlyFromId;
        await LoadMonthlyAsync();
    }

    private async Task OnMonthlyToChanged(int id)
    {
        _monthlyToId = id;
        await LoadMonthlyAsync();
    }

    private async Task LoadActualAsync()
    {
        if (Account == null || _actualFromId == 0 || _actualToId == 0)
            return;

        _busyActual = true;
        try
        {
            _actual = await LoadBalanceAsync(_actualFromId, _actualToId);
        }
        finally
        {
            _busyActual = false;
        }
    }

    private async Task LoadMonthlyAsync()
    {
        if (Account == null || _monthlyFromId == 0 || _monthlyToId == 0)
            return;

        _busyMonthly = true;
        try
        {
            _monthly = await LoadBalanceAsync(_monthlyFromId, _monthlyToId);
        }
        finally
        {
            _busyMonthly = false;
        }
    }

    private async Task<Account?> LoadBalanceAsync(int fromId, int toId)
    {
        var from = _periods.FirstOrDefault(p => p.Id == fromId);
        var to = _periods.FirstOrDefault(p => p.Id == toId);
        if (from == null || to == null || Account == null)
            return null;

        try
        {
            return await AccountService.GetAccountBalanceAsync(
                CompanyId,
                Account.Id,
                RangeStart(from.Date),
                RangeEnd(to.Date));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al obtener el reporte de saldos: {ex.Message}", Severity.Error);
            return null;
        }
    }

    private string FormatPeriod(int id) =>
        _periods.FirstOrDefault(p => p.Id == id)?.ToString() ?? string.Empty;

    private static DateTime RangeStart(DateTime date) => new(date.Year, date.Month, 1);

    private static DateTime RangeEnd(DateTime date) =>
        new DateTime(date.Year, date.Month, 1).AddMonths(1).AddDays(-1);

    private static string BalanceClass(decimal amount) =>
        amount < 0 ? "text-danger" : "text-success";
}
