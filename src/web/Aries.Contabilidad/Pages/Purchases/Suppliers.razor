@page "/purchases/{CompanyId}/suppliers"
@using AriesContador.Core.Models.Purchases
@using AriesContador.Core.Models.Utils
@inject IPurchasingClient Purchasing
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <h1 class="page-title">Proveedores</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row mb-3 g-2">
        <div class="col-md-8">
            <input class="form-control" placeholder="Buscar por nombre, cédula, correo o teléfono" @bind="search" @bind:event="oninput" />
        </div>
        <div class="col-md-4 text-md-end">
            <button class="btn btn-primary" @onclick="StartCreate"><i class="fas fa-plus"></i> Agregar proveedor</button>
        </div>
    </div>

    @if (editing)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5>@(form.Id == 0 ? "Nuevo proveedor" : "Editar proveedor")</h5>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">Nombre / razón social</label>
                        <input class="form-control" @bind="form.Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo de identificación</label>
                        <select class="form-select" @bind="form.IdType">
                            @foreach (IdType type in Enum.GetValues(typeof(IdType)))
                            {
                                <option value="@type">@IdTypeLabel(type)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cédula / DIMEX / NITE</label>
                        <input class="form-control" @bind="form.NumberId" placeholder="3-101-123456" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Correo</label>
                        <input class="form-control" type="email" @bind="form.Email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Teléfono</label>
                        <input class="form-control" @bind="form.Phone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Dirección</label>
                        <input class="form-control" @bind="form.Address" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Notas</label>
                        <textarea class="form-control" rows="2" @bind="form.Notes"></textarea>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="Save" disabled="@saving">Guardar</button>
                    <button class="btn btn-secondary" @onclick="CancelEdit">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (suppliers == null)
    {
        <div class="d-flex justify-content-center"><div class="spinner-border"></div></div>
    }
    else
    {
        <div class="card">
            <div class="card-body table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Identificación</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in Filtered)
                        {
                            <tr>
                                <td>@supplier.Name</td>
                                <td>@IdTypeLabel(supplier.IdType) @(string.IsNullOrWhiteSpace(supplier.NumberId) ? "" : supplier.NumberId)</td>
                                <td>@supplier.Email</td>
                                <td>@supplier.Phone</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary me-1" @onclick="() => StartEdit(supplier)">Editar</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => Delete(supplier)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string CompanyId { get; set; } = string.Empty;
    private List<Supplier>? suppliers;
    private Supplier form = new();
    private bool editing;
    private bool saving;
    private string search = string.Empty;
    private string? errorMessage;

    private IEnumerable<Supplier> Filtered =>
        (suppliers ?? new List<Supplier>()).Where(s =>
            string.IsNullOrWhiteSpace(search)
            || (s.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.NumberId?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.Email?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.Phone?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        errorMessage = null;
        suppliers = await Purchasing.GetAllAsync(CompanyId);
    }

    private void StartCreate()
    {
        form = new Supplier
        {
            CompanyId = CompanyId,
            Active = true,
            IdType = IdType.CEDULA_JURIDICA
        };
        editing = true;
    }

    private void StartEdit(Supplier supplier)
    {
        form = new Supplier
        {
            Id = supplier.Id,
            CompanyId = supplier.CompanyId,
            Name = supplier.Name,
            IdType = supplier.IdType,
            NumberId = supplier.NumberId,
            Email = supplier.Email,
            Phone = supplier.Phone,
            Address = supplier.Address,
            Notes = supplier.Notes,
            Active = supplier.Active
        };
        editing = true;
    }

    private void CancelEdit() => editing = false;

    private async Task Save()
    {
        saving = true;
        errorMessage = null;
        try
        {
            form.CompanyId = CompanyId;
            if (form.Id == 0)
                await Purchasing.CreateAsync(form);
            else
                await Purchasing.UpdateAsync(form);
            editing = false;
            await Reload();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete(Supplier supplier)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"¿Eliminar {supplier.Name}?"))
            return;
        try
        {
            await Purchasing.DeleteAsync(supplier.Id);
            await Reload();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static string IdTypeLabel(IdType type) => type switch
    {
        IdType.CEDULA_JURIDICA => "Cédula jurídica",
        IdType.CEDULA_NACIONAL => "Cédula nacional",
        IdType.DIMEX => "DIMEX",
        IdType.NITE => "NITE",
        _ => type.ToString()
    };
}
