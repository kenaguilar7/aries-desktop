@using Microsoft.AspNetCore.Components.Authorization
@using Aries.Contabilidad.Services
@using AriesContador.Core.Models.Companies
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<nav class="side-nav">
    <AuthorizeView>
        <Authorized>
            @if (!string.IsNullOrEmpty(CurrentCompanyId))
            {
                <NavLink class="side-nav-link" href="@InicioHref" Match="NavLinkMatch.All" @onclick="NotifyNavigate">
                    <i class="fas fa-home"></i>
                    <span>Inicio</span>
                </NavLink>

                <div class="side-nav-group">
                    <button type="button" class="side-nav-group-toggle @(IsGroupActive("contab") ? "active" : null)" @onclick='() => Toggle("contab")'>
                        <span>Contabilidad</span>
                        <i class="fas @(_expanded.Contains("contab") ? "fa-chevron-down" : "fa-chevron-right")"></i>
                    </button>
                    @if (_expanded.Contains("contab"))
                    {
                        <div class="side-nav-children">
                            <NavLink class="side-nav-link" href="@JournalHref" @onclick="NotifyNavigate">
                                <span>Asientos</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@AccountsHref" @onclick="NotifyNavigate">
                                <span>Plan de cuentas</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/accounting/{CurrentCompanyId}/periods")" @onclick="NotifyNavigate">
                                <span>Periodos</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/accounting/{CurrentCompanyId}/restore")" @onclick="NotifyNavigate">
                                <span>Elementos eliminados</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/accounting/{CurrentCompanyId}/reports")" @onclick="NotifyNavigate">
                                <span>Reportes</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <div class="side-nav-group">
                    <button type="button" class="side-nav-group-toggle @(IsGroupActive("pos") ? "active" : null)" @onclick='() => Toggle("pos")'>
                        <span>Punto de venta</span>
                        <i class="fas @(_expanded.Contains("pos") ? "fa-chevron-down" : "fa-chevron-right")"></i>
                    </button>
                    @if (_expanded.Contains("pos"))
                    {
                        <div class="side-nav-children">
                            <NavLink class="side-nav-link" href="@($"/pos/{CurrentCompanyId}/sales")" @onclick="NotifyNavigate">
                                <span>Ventas</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/pos/{CurrentCompanyId}/registers")" @onclick="NotifyNavigate">
                                <span>Cajas</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/pos/{CurrentCompanyId}/caja")" @onclick="NotifyNavigate">
                                <span>Apertura / Cierre</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/pos/{CurrentCompanyId}/inventory")" @onclick="NotifyNavigate">
                                <span>Inventario</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/pos/{CurrentCompanyId}/reports")" @onclick="NotifyNavigate">
                                <span>Reportes POS</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/pos/{CurrentCompanyId}/dashboard")" @onclick="NotifyNavigate">
                                <span>Resumen</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <div class="side-nav-group">
                    <button type="button" class="side-nav-group-toggle @(IsGroupActive("compras") ? "active" : null)" @onclick='() => Toggle("compras")'>
                        <span>Compras</span>
                        <i class="fas @(_expanded.Contains("compras") ? "fa-chevron-down" : "fa-chevron-right")"></i>
                    </button>
                    @if (_expanded.Contains("compras"))
                    {
                        <div class="side-nav-children">
                            <NavLink class="side-nav-link" href="@($"/purchases/{CurrentCompanyId}")" @onclick="NotifyNavigate" Match="NavLinkMatch.All">
                                <span>Compras</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/purchases/{CurrentCompanyId}/new")" @onclick="NotifyNavigate">
                                <span>Nueva compra</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/purchases/{CurrentCompanyId}/suppliers")" @onclick="NotifyNavigate">
                                <span>Proveedores</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <div class="side-nav-group">
                    <button type="button" class="side-nav-group-toggle @(IsGroupActive("integration") ? "active" : null)" @onclick='() => Toggle("integration")'>
                        <span>Integración</span>
                        <i class="fas @(_expanded.Contains("integration") ? "fa-chevron-down" : "fa-chevron-right")"></i>
                    </button>
                    @if (_expanded.Contains("integration"))
                    {
                        <div class="side-nav-children">
                            <NavLink class="side-nav-link" href="@($"/integration/{CurrentCompanyId}/pos-accounting")" @onclick="NotifyNavigate">
                                <span>POS → Contabilidad</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/integration/{CurrentCompanyId}/account-map")" @onclick="NotifyNavigate">
                                <span>Mapeo de cuentas</span>
                            </NavLink>
                            <NavLink class="side-nav-link" href="@($"/integration/{CurrentCompanyId}/reconciliation")" @onclick="NotifyNavigate">
                                <span>Conciliación</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <div class="side-nav-group">
                    <button type="button" class="side-nav-group-toggle @(IsGroupActive("automations") ? "active" : null)" @onclick='() => Toggle("automations")'>
                        <span>Automatizaciones</span>
                        <i class="fas @(_expanded.Contains("automations") ? "fa-chevron-down" : "fa-chevron-right")"></i>
                    </button>
                    @if (_expanded.Contains("automations"))
                    {
                        <div class="side-nav-children">
                            <NavLink class="side-nav-link side-nav-wip-link" href="@($"/automations/{CurrentCompanyId}/recurring")" @onclick="NotifyNavigate">
                                <span>Recurrencias</span>
                                <span class="side-nav-wip">en construcción</span>
                            </NavLink>
                            <NavLink class="side-nav-link side-nav-wip-link" href="@($"/automations/{CurrentCompanyId}/rules")" @onclick="NotifyNavigate">
                                <span>Reglas</span>
                                <span class="side-nav-wip">en construcción</span>
                            </NavLink>
                            <NavLink class="side-nav-link side-nav-wip-link" href="@($"/automations/{CurrentCompanyId}/alerts")" @onclick="NotifyNavigate">
                                <span>Alertas</span>
                                <span class="side-nav-wip">en construcción</span>
                            </NavLink>
                        </div>
                    }
                </div>
            }

            <div class="side-nav-group">
                <button type="button" class="side-nav-group-toggle @(IsGroupActive("admin") ? "active" : null)" @onclick='() => Toggle("admin")'>
                    <span>Administración</span>
                    <i class="fas @(_expanded.Contains("admin") ? "fa-chevron-down" : "fa-chevron-right")"></i>
                </button>
                @if (_expanded.Contains("admin"))
                {
                    <div class="side-nav-children">
                        <NavLink class="side-nav-link" href="/companies" @onclick="NotifyNavigate">
                            <span>Compañías</span>
                        </NavLink>
                        <NavLink class="side-nav-link side-nav-wip-link" href="/admin/users" @onclick="NotifyNavigate">
                            <span>Usuarios y permisos</span>
                            <span class="side-nav-wip">en construcción</span>
                        </NavLink>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private string? CurrentCompanyId { get; set; }
    private Company? CurrentCompany { get; set; }
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase) { "contab", "pos" };

    private string InicioHref => $"/dashboard/{CurrentCompanyId}";
    private string JournalHref => $"/journal-entries/{CurrentCompanyId}/create";
    private string AccountsHref => $"/accounts/{CurrentCompanyId}";

    protected override async Task OnInitializedAsync()
    {
        await CheckCompanyData();
        EnsureActiveGroupExpanded();
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckCompanyData();
        EnsureActiveGroupExpanded();
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await CheckCompanyData();
        EnsureActiveGroupExpanded();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckCompanyData()
    {
        try
        {
            var companyData = await LocalStorage.GetStoredCompany();
            if (companyData != null)
            {
                CurrentCompanyId = companyData.Code;
                CurrentCompany = companyData;
            }
            else
            {
                CurrentCompanyId = TryCompanyIdFromPath();
                CurrentCompany = null;
            }

            if (string.IsNullOrEmpty(CurrentCompanyId))
                _expanded.Add("admin");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "Error checking company data:", ex.Message);
        }
    }

    private string? TryCompanyIdFromPath()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length < 2)
            return null;

        var prefixes = new[] { "dashboard", "accounts", "journal-entries", "pos", "accounting", "integration", "automations", "purchases" };
        if (prefixes.Contains(segments[0], StringComparer.OrdinalIgnoreCase))
            return segments[1];

        return null;
    }

    private bool IsGroupActive(string group)
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return group switch
        {
            "contab" => Starts(path, "journal-entries") || Starts(path, "accounts") || Starts(path, "accounting"),
            "pos" => Starts(path, "pos/"),
            "compras" => Starts(path, "purchases/"),
            "integration" => Starts(path, "integration/"),
            "automations" => Starts(path, "automations/"),
            "admin" => Starts(path, "companies") || Starts(path, "admin/"),
            _ => false
        };
    }

    private static bool Starts(string path, string prefix) =>
        path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    private void EnsureActiveGroupExpanded()
    {
        foreach (var group in new[] { "contab", "pos", "compras", "integration", "automations", "admin" })
        {
            if (IsGroupActive(group))
                _expanded.Add(group);
        }
    }

    private void Toggle(string group)
    {
        if (!_expanded.Add(group))
            _expanded.Remove(group);
    }

    private async Task NotifyNavigate()
    {
        if (OnNavigate.HasDelegate)
            await OnNavigate.InvokeAsync();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
