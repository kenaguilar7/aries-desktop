@page "/journal-entries/{CompanyId}/create"
@inject JournalWorkspaceGuard Guard
@inject ISnackbar Snackbar

<PageTitle>Asientos - Aries Contabilidad</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeNav" />

<div class="container-fluid px-0">
    <JournalEntryEditor CompanyId="@CompanyId" />
</div>

@code {
    [Parameter]
    public string CompanyId { get; set; } = string.Empty;

    private void OnBeforeNav(LocationChangingContext context)
    {
        if (Guard.CanLeave)
            return;

        context.PreventNavigation();
        Snackbar.Add(Guard.Message, Severity.Warning);
    }
}
