<div class="card">
    <div class="card-body p-0">
        @if (Lines.Count == 0)
        {
            <p class="text-muted mb-0 p-3">No hay líneas en este asiento.</p>
        }
        else
        {
            <div class="table-responsive asientos-grid">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 2.5rem;">
                                <input type="checkbox" class="form-check-input" checked="@AllSelected" disabled="@ReadOnly" @onchange="ToggleAll" />
                            </th>
                            <th>Cuenta</th>
                            <th>Referencia</th>
                            <th>Detalle</th>
                            <th>Fecha</th>
                            <th class="text-end">Débitos</th>
                            <th class="text-end">Créditos</th>
                            @if (ShowFx)
                            {
                                <th>Moneda</th>
                                <th class="text-end">Tipo cambio</th>
                                <th class="text-end">Monto USD</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Lines)
                        {
                            var selected = SelectedIds.Contains(line.Id);
                            <tr class="@(selected ? "asientos-row-selected" : null)" @onclick="() => ToggleRow(line.Id)">
                                <td @onclick:stopPropagation="true">
                                    <input type="checkbox" class="form-check-input" checked="@selected" disabled="@ReadOnly" @onchange="() => ToggleRow(line.Id)" />
                                </td>
                                <td>
                                    <div>@line.AccountName</div>
                                    @if (!string.IsNullOrWhiteSpace(line.AccountPath))
                                    {
                                        <div class="text-muted small text-truncate" title="@line.AccountPath">@line.AccountPath</div>
                                    }
                                </td>
                                <td>@line.Reference</td>
                                <td>@line.Memo</td>
                                <td>@(line.Date == default ? string.Empty : line.Date.ToString("dd/MM/yyyy"))</td>
                                <td class="text-end">@(line.DebOrCred == DebOrCred.Debito ? AsientosUi.Colones(line.Amount) : string.Empty)</td>
                                <td class="text-end">@(line.DebOrCred == DebOrCred.Credito ? AsientosUi.Colones(line.Amount) : string.Empty)</td>
                                @if (ShowFx)
                                {
                                    <td>@AsientosUi.CurrencyLabel(line.Currency)</td>
                                    <td class="text-end">@(line.Currency == Currency.dolares ? AsientosUi.Colones(line.RateAmount) : string.Empty)</td>
                                    <td class="text-end">@(line.Currency == Currency.dolares ? AsientosUi.Dollars(line.ForeignAmount) : string.Empty)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<JournalEntryLine> Lines { get; set; } = new();
    [Parameter] public HashSet<int> SelectedIds { get; set; } = new();
    [Parameter] public bool ShowFx { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<HashSet<int>> SelectedIdsChanged { get; set; }

    private bool AllSelected => Lines.Count > 0 && Lines.All(l => SelectedIds.Contains(l.Id));

    private async Task ToggleRow(int id)
    {
        if (ReadOnly)
            return;
        if (!SelectedIds.Remove(id))
            SelectedIds.Add(id);
        await SelectedIdsChanged.InvokeAsync(SelectedIds);
    }

    private async Task ToggleAll(ChangeEventArgs e)
    {
        if (ReadOnly)
            return;
        var check = e.Value is bool flag
            ? flag
            : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        SelectedIds.Clear();
        if (check)
        {
            foreach (var line in Lines)
                SelectedIds.Add(line.Id);
        }
        await SelectedIdsChanged.InvokeAsync(SelectedIds);
    }
}
