@page "/pos/{CompanyId}/inventory"
@using AriesContador.Core.Models.PointOfSale
@inject IPosService PosService
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <h3 class="mb-3">Inventario</h3>
    <PosNav CompanyId="@CompanyId" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row mb-3 g-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Buscar por nombre, código o categoría" @bind="search" @bind:event="oninput" />
        </div>
        <div class="col-md-4">
            <input class="form-control" placeholder="Escanear código de barras" @bind="barcodeSearch" @onkeydown="OnBarcodeKey" />
        </div>
        <div class="col-md-4 text-md-end">
            <button class="btn btn-primary" @onclick="StartCreate"><i class="fas fa-plus"></i> Agregar producto</button>
        </div>
    </div>

    @if (editing)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5>@(form.Id == 0 ? "Nuevo producto" : "Editar producto")</h5>
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Código de barras</label>
                        <input class="form-control" @bind="form.Barcode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="form.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Categoría</label>
                        <input class="form-control" @bind="form.Category" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Precio</label>
                        <input class="form-control" type="number" step="0.01" @bind="form.Price" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Stock</label>
                        <input class="form-control" type="number" step="0.001" @bind="form.Stock" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="soldByWeight" @bind="form.SoldByWeight" />
                            <label class="form-check-label" for="soldByWeight">Vender por peso</label>
                        </div>
                    </div>
                    @if (form.SoldByWeight)
                    {
                        <div class="col-md-3">
                            <label class="form-label">Precio por kilo</label>
                            <input class="form-control" type="number" step="0.01" @bind="form.PricePerKilo" />
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="Save" disabled="@saving">Guardar</button>
                    <button class="btn btn-secondary" @onclick="CancelEdit">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (products == null)
    {
        <div class="d-flex justify-content-center"><div class="spinner-border"></div></div>
    }
    else
    {
        <div class="card">
            <div class="card-body table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Stock</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Filtered)
                        {
                            <tr>
                                <td>@product.Barcode</td>
                                <td>@product.Name @(product.SoldByWeight ? "(peso)" : "")</td>
                                <td>@product.Category</td>
                                <td class="text-end">@(product.SoldByWeight ? product.PricePerKilo?.ToString("N2") + "/kg" : product.Price.ToString("N2"))</td>
                                <td class="text-end">@product.Stock.ToString("N3")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary me-1" @onclick="() => StartEdit(product)">Editar</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => Delete(product)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string CompanyId { get; set; } = string.Empty;
    private List<Product>? products;
    private Product form = new();
    private bool editing;
    private bool saving;
    private string search = string.Empty;
    private string barcodeSearch = string.Empty;
    private string? errorMessage;

    private IEnumerable<Product> Filtered =>
        (products ?? new List<Product>()).Where(p =>
            string.IsNullOrWhiteSpace(search)
            || (p.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (p.Barcode?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (p.Category?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        errorMessage = null;
        products = await PosService.GetProductsAsync(CompanyId);
    }

    private void StartCreate()
    {
        form = new Product { CompanyId = CompanyId, Active = true, Category = "General" };
        editing = true;
    }

    private void StartEdit(Product product)
    {
        form = new Product
        {
            Id = product.Id,
            CompanyId = product.CompanyId,
            Barcode = product.Barcode,
            Name = product.Name,
            Category = product.Category,
            Price = product.Price,
            Stock = product.Stock,
            SoldByWeight = product.SoldByWeight,
            PricePerKilo = product.PricePerKilo,
            Active = product.Active
        };
        editing = true;
    }

    private void CancelEdit() => editing = false;

    private async Task Save()
    {
        saving = true;
        errorMessage = null;
        try
        {
            form.CompanyId = CompanyId;
            if (form.Id == 0)
                await PosService.CreateProductAsync(form);
            else
                await PosService.UpdateProductAsync(form);
            editing = false;
            await Reload();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete(Product product)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"¿Eliminar {product.Name}?"))
            return;
        try
        {
            await PosService.DeleteProductAsync(product.Id);
            await Reload();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task OnBarcodeKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(barcodeSearch))
            return;
        var found = await PosService.FindByBarcodeAsync(CompanyId, barcodeSearch.Trim());
        barcodeSearch = string.Empty;
        if (found != null)
            StartEdit(found);
        else
            errorMessage = "Producto no encontrado";
    }
}
